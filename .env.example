# Password for /admin (where you create clients and copy their links/tokens)
ADMIN_PASSWORD=change-me

# Postgres connection string (Neon / Supabase / Vercel Postgres). Leave empty to
# use a local JSON file in ./data — fine for local testing, NOT for production.
DATABASE_URL=

# Create a demo real-estate client with 30 days of sample activity when the DB is empty.
SEED_DEMO=true
